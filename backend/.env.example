# Variables de entorno del proyecto.
#
# Este archivo es una PLANTILLA de ejemplo y sí se sube al repositorio.
# Si necesitas valores propios, cópialo a un archivo llamado ".env"
# (que está ignorado por git y nunca se sube):
#
#     cp .env.example .env
#
# IMPORTANTE: para el uso normal con "docker compose up" NO hace falta crear
# ningún .env. El docker-compose.yml ya define DATABASE_URL apuntando al
# contenedor de la base de datos. Este archivo solo se necesita si quieres
# ejecutar la API fuera de Docker o conectarla a otra base de datos.

# Dirección de la base de datos.
# Formato: motor+driver://usuario:contraseña@servidor:puerto/nombre_bd
#
#   - Dentro de Docker el servidor se llama "db" (el nombre del servicio).
#   - Fuera de Docker sería "localhost".
DATABASE_URL=postgresql+psycopg2://lis_user:lis_password@db:5432/lis_equipos
