# ===========================================================================
# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
# El archivo `.env` esta en .gitignore: NO se sube al repositorio.
#
# En PowerShell se cargan asi (desde la carpeta del proyecto):
#
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }
#   .\mvnw.cmd spring-boot:run
# ===========================================================================

# --- Base de datos PostgreSQL (Neon, Supabase, Railway, local...) ----------
# Formato JDBC. Con proveedores en la nube suele hacer falta ?sslmode=require
DB_URL=jdbc:postgresql://HOST/NOMBRE_BD?sslmode=require
DB_USERNAME=usuario
DB_PASSWORD=contrasena

# --- Firma de los JWT -----------------------------------------------------
# HS384 exige al menos 48 caracteres. La aplicacion no arranca si es mas corta.
# Generar uno aleatorio en PowerShell:
#   -join ((48..57) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET=cambiar-por-una-cadena-aleatoria-de-al-menos-48-caracteres

# --- Google OAuth2 (BONUS: SSO institucional) -----------------------------
# Se obtienen en https://console.cloud.google.com/apis/credentials
# URI de redireccion autorizada que hay que registrar alli:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Opcionales (tienen valor por defecto) --------------------------------

# A donde se envia al usuario tras iniciar sesion, con ?token=<jwt>
# FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# Origenes autorizados para CORS, separados por comas
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gestion del inventario (POST y PUT de /api/equipment).
# true (por defecto) -> exige sesion con ROLE_USER.
# false -> abierto, util para revisar la API sin iniciar sesion.
# PROTECT_EQUIPMENT=true

# Reservas (POST y DELETE de /api/reservations).
# false (por defecto) -> publicas, identificandose con nombre y correo.
# true -> exige JWT con ROLE_USER (modo bonus del enunciado).
# PROTECT_RESERVATIONS=false

# Duracion maxima de una reserva, en horas.
# RESERVATION_MAX_HOURS=8

# Cargar el catalogo de equipos de ejemplo si la tabla esta vacia
# SEED_ENABLED=true