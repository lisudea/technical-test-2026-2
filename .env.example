DATABASE_URL="postgresql://lis:lis@localhost:5433/lisdb?schema=public"
PORT=3000

# Firma de los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia-este-secreto"

# Client ID de OAuth en Google Cloud Console (APIs y servicios > Credenciales).
# Si queda vacío, el login con Google responde 503 y el resto de la API funciona normal.
GOOGLE_CLIENT_ID=""

# Envío de correos de recuperación (resend.com). Vacío = el enlace sale por el log del servidor.
RESEND_API_KEY=""
# URL del frontend, usada para armar el enlace de recuperación
FRONTEND_URL="http://localhost:5173"

# DSN de Sentry para monitoreo de errores del backend (opcional)
SENTRY_DSN=
