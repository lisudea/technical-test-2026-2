DATABASE_URL="postgresql://lis:lis@localhost:5433/lisdb?schema=public"
PORT=3000

# Firma de los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia-este-secreto"

# Client ID de OAuth en Google Cloud Console (APIs y servicios > Credenciales).
# Si queda vacío, el login con Google responde 503 y el resto de la API funciona normal.
GOOGLE_CLIENT_ID=""

# Envío de correos de recuperación (resend.com). Vacío = el enlace sale por el log del servidor.
RESEND_API_KEY=""
# URL del frontend, usada para armar el enlace de recuperación
FRONTEND_URL="http://localhost:5173"

# Orígenes permitidos por CORS (coma-separados). En producción pon el dominio del
# frontend, p. ej. "https://lis-reservas.vercel.app". Si queda vacío usa FRONTEND_URL.
CORS_ORIGINS="http://localhost:5173"

# DSN de Sentry para monitoreo de errores del backend (opcional)
SENTRY_DSN=

# Remitente de los correos (requiere dominio verificado en Resend)
CORREO_REMITENTE="LIS Reservas <lis@tudominio.com>"

# Moderación del foro con Claude (console.anthropic.com). Vacío = se publica sin revisar.
# Con la clave puesta, cada publicación pasa por Claude, que la habilita o la rechaza.
ANTHROPIC_API_KEY=""
# Modelo a usar (opcional). Por defecto claude-opus-4-8.
ANTHROPIC_MODEL="claude-opus-4-8"
